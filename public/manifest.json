{
  "manifest_version": 3,
  "name": "Graphcal for GitHub",
  "version": "0.1.0",
  "description": "Open Graphcal sheets from GitHub in the Graphcal viewer, read with your GitHub sign-in.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open in Graphcal view",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab"],
  "host_permissions": ["https://github.com/*", "https://raw.githubusercontent.com/*"],
  "externally_connectable": { "matches": ["https://graphcal.org/*", "http://localhost/*"] }
}
